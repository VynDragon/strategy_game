#include <zephyr/dt-bindings/input/keymap.h>

&pinctrl {
	spi0_default: spi0_default {
		group1 {
			pinmux = <GPIO11_SPI_MOSI>, <GPIO13_SPI_SCLK>;
			drive-strength = <1>;
			input-schmitt-enable;
		};
	};
};

/ {

	mipi_dbi_ssd1327 {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi0>;
		dc-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		display: ssd1327@0 {
			compatible = "solomon,ssd1327";
			mipi-max-frequency = <20000000>;
			reg = <0>;
			width = <128>;
			height = <64>;
			prechargep = <0x5>;
			precharge-voltage = <0x7>;
			remap-value = <0x53>;
			oscillator-freq = <0xA1>;
			display-offset = <0x40>;
			start-line = <0>;
			multiplex-ratio = <0x3f>;
			phase-length = <0x29>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			grayscale-table = [04 06 08 0A 0C 0D 10 12 14 16 18 1C 20 24 3C];
		};
		// display: ssd1322@0 {
		// 	compatible = "solomon,ssd1322";
		// 	mipi-max-frequency = <21000000>;
		// 	reg = <0>;
		// 	oscillator-freq = <0xe1>;
		// 	width = <240>;
		// 	height = <128>;
		// 	column-offset=<24>;
		// 	row-offset=<0>;
		// 	start-line = <0>;
		// 	mux-ratio = <127>;
		// 	vcomh-voltage = <0x6>;
		// 	precharge-voltage = <0x1f>;
		// 	phase-length = <0xd2>;
		// 	mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
		// 	remap-nibble;
		// 	/* Commented remaps, offset is 36, otherwise 24 */
		// 	remap-columns;
		// 	remap-rows;
		// 	remap-com-odd-even-split;
		// 	grayscale-enhancement;
		// 	grayscale-enhancement-lg;
		// 	grayscale-table = [34 38 3A 40 48 50 58 60 68 70 78 80 96 A0 AA];
		// };
	};
};

&spi0 {
	status = "okay";
	cs-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;

	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
};

