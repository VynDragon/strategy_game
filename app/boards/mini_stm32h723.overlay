#include <zephyr/dt-bindings/input/keymap.h>

&spi1 {
	status = "disabled";
};
&sdmmc1 {
	status = "disabled";
};

/delete-node/ &dcmi_camera_connector;

/ {
	kbd-matrix {
		compatible = "gpio-kbd-matrix";
		row-gpios = <&gpioe 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
					<&gpiob 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
					<&gpiob 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
					<&gpiob 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
					<&gpiod 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		col-gpios = <&gpioc 12 GPIO_ACTIVE_LOW>,
					<&gpiod 1 GPIO_ACTIVE_LOW>,
					<&gpiod 3 GPIO_ACTIVE_LOW>,
					<&gpiod 5 GPIO_ACTIVE_LOW>;
		keymap {
			compatible = "input-keymap";
			keymap = <
				MATRIX_KEY(3, 1, INPUT_KEY_W)
				MATRIX_KEY(4, 1, INPUT_KEY_S)
				MATRIX_KEY(4, 0, INPUT_KEY_A)
				MATRIX_KEY(4, 2, INPUT_KEY_D)
				MATRIX_KEY(3, 0, INPUT_KEY_LEFT)
				MATRIX_KEY(3, 2, INPUT_KEY_RIGHT)
				MATRIX_KEY(1, 3, INPUT_KEY_UP)
				MATRIX_KEY(2, 3, INPUT_KEY_DOWN)
				MATRIX_KEY(3, 3, INPUT_KEY_LEFTSHIFT)
				MATRIX_KEY(4, 3, INPUT_KEY_SPACE)
			>;
			row-size = <5>;
			col-size = <4>;
		};
	};
};
